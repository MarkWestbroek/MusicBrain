        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Switch_0" name="positions : string[]"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Switch_1" name="defaultIndex : int"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="c_Button" name="Button" isAbstract="false">
