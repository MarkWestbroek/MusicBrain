<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1">
  <xmi:Documentation exporter="MusicBrain tools/uml_xmi_gen.py" exporterVersion="1.0"/>
  <uml:Model xmi:type="uml:Model" xmi:id="mmb_model" name="MMB ModuleType-Panel">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_Contract" name="Contract">
      <packagedElement xmi:type="uml:Class" xmi:id="c_ModuleType" name="ModuleType" isAbstract="false">
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_ModuleType_0" name="id : string"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_ModuleType_1" name="categoryId : string"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_ModuleType_2" name="variant : string"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_ModuleType_3" name="role : ModuleRole"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_ModuleType_4" name="internal : bool"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="c_Port" name="Port" isAbstract="false">
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Port_0" name="id : string"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Port_1" name="signalType : cv|gate|trigger|audio|midi"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Port_2" name="direction : in|out"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Port_3" name="range : CvRange"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Port_4" name="cvFormat : analog|dcv12|dcv16"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Port_5" name="eventKind : voice|global"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="c_Control" name="Control" isAbstract="true">
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Control_0" name="id : string"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Control_1" name="label : string"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="c_Knob" name="Knob" isAbstract="false">
        <generalization xmi:type="uml:Generalization" xmi:id="g_Knob_Control" general="c_Control"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Knob_0" name="min : float"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Knob_1" name="max : float"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Knob_2" name="defaultValue : float"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Knob_3" name="step : float"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Knob_4" name="taper : lin|log|exp"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Knob_5" name="style : KnobStyle"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="c_Slider" name="Slider" isAbstract="false">
