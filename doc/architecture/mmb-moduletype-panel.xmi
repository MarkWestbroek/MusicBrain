        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Display_1" name="format : int|float1|float2|midi|onoff"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="p_Display_2" name="style : led|oled"/>
