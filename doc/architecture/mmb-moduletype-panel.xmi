      <packagedElement xmi:type="uml:Association" xmi:id="assoc_0" name="ports" memberEnd="assoc_0_a assoc_0_b">
        <ownedEnd xmi:type="uml:Property" xmi:id="assoc_0_a" type="c_ModuleType" association="assoc_0" aggregation="composite">
