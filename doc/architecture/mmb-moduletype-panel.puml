@startuml mmb-moduletype-panel
' MMB: ModuleType (Model/contract) — Panel (View) — realisaties.
' As-built naar editor/src/modular-mb/types.ts (2026-07-06); Readout, DeviceDisplay en
' de readout-kant van Indicator zijn voorstel (doc/plans/module-meldwaarden.md, 2026-10-06).
' Bron voor doc/architecture/mmb-moduletype-panel.xmi (EA-import);
' regenereer die met tools/uml_xmi_gen.py (model als data daarin) na wijzigingen hier.
' Hetzelfde model als Omnium V3 (mmb-moduletype-panel.v3.json) en als SVG via de
' Omnium-render-sidecar: tools/mmb_model_v3.py (leest dezelfde data).

package "Contract (het midden: ModuleType-data)" {
  class ModuleType {
    id : string
    categoryId : string
    variant : string
    role : ModuleRole
    internal : bool
  }
  class Port {
    id : string
    signalType : cv|gate|trigger|audio|midi
    direction : in|out
    range : CvRange
    cvFormat : analog|dcv12|dcv16
    eventKind : voice|global
  }
  abstract class Control {
    id : string
    label : string
  }
  class Knob {
    min : float
    max : float
    defaultValue : float
    step : float
    taper : lin|log|exp
    style : KnobStyle
  }
  class Slider
  class Toggle
  class Switch {
    positions : string[]
    defaultIndex : int
  }
  class Button
  class Joystick
  class Exotic
  abstract class Indicator {
    bindTo : Control.id | Readout.id
  }
  class Display {
    digits : int
    format : int|float1|float2|midi|onoff
    style : led|oled
  }
  class Led {
    color : string
    bindMatch : float
  }
  class CellGroup {
    id : string
    label : string
    count : int
  }
  class Readout <<voorstel>> {
    id : string
    kind : number|text
    label : string
    unit : string
  }

  ModuleType "1" *-- "1..*" Port
  ModuleType "1" *-- "0..*" Control
  ModuleType "1" *-- "0..*" Readout
  ModuleType "1" *-- "0..*" CellGroup
  Indicator --> "0..1" Readout : bindTo
  CellGroup --> "0..*" Port : portIds (per cel)
  CellGroup --> "0..*" Control : controlIds (per cel)
  Control <|-- Knob
  Control <|-- Slider
  Control <|-- Toggle
  Control <|-- Switch
  Control <|-- Button
  Control <|-- Joystick
  Control <|-- Exotic
  Control <|-- Indicator
  Indicator <|-- Display
  Indicator <|-- Led
  note right of Indicator
    read-only: toont een Control-waarde
    of een Readout (bindTo), of statische tekst
  end note
  note right of Readout
    Toestand die de module zelf maakt
    (stap, banknaam, klanknaam, piek).
    Geen control: niet in de patch,
    er is alleen een waarde zolang de
    module draait.
  end note
}

package "View (paneel)" {
  class Panel <<View>> {
    hpWidth : HP
    heightMm : float
    texture : PanelTexture
    baseColor : string
  }
  class ControlPlacement {
    x : mm
    y : mm
    rotation : deg
    sizeOverride : ControlSize
  }
  class PortPlacement {
    x : mm
    y : mm
    labelPos : above|below|left|right|none
  }
  class PanelDecoration {
    kind : rect|line|text|tubeSlot|ledMarker|jackBlock
  }
  class DeviceDisplay <<View, voorstel>> {
    toont readouts van 1..* modules
    (display op de Teensy / FRONT-kaart)
  }
  DeviceDisplay --> "0..*" Readout : toont

  Panel "0..*" --> "1" ModuleType : visualiseert
  Panel *-- "0..*" ControlPlacement
  Panel *-- "0..*" PortPlacement
  Panel *-- "0..*" PanelDecoration
  ControlPlacement --> "1" Control : per id
  PortPlacement --> "1" Port : per id
  note bottom of Panel
    Nu 1-op-1 op de instantie (ModuleVisual);
    meerdere panels per type = uitbreiding.
    Voorstel: + minFirmwareVersion : semver
  end note
}

package "Realisaties" {
  class ModuleInstance {
    id : string
  }
  class FirmwareModule <<C++ Teensy>> {
    kTypeId : const char*
    inputPortKind(portId)
    writeCvPort(portId, v)
    setControl(controlId, v)
    readouts(sink) (voorstel)
  }
  class SimModule <<browser, wasm>> {
    mmb_readout_count() (voorstel)
    mmb_readout(i) (voorstel)
  }

  ModuleInstance --> "1" ModuleType : typeId
  ModuleInstance *-- "1" Panel : visual
  FirmwareModule ..|> ModuleType : realiseert via strings\n(bewaakt door contract-test)
  SimModule ..|> ModuleType : realiseert (simulatedBy)
  note bottom of FirmwareModule
    Contract gegenereerd uit de broncode:
    tools/contract_dump.py ->
    firmware/.../contract/module-types.json;
    editor-CI valideert (contract.test.ts)
  end note
}
@enduml
