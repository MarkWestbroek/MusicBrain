(kicad_pcb
  (version 20240108)
  (generator "pcbnew")
  (generator_version "8.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" dielectric 1)
    (2 "In2.Cu" dielectric 2)
    (3 "B.Cu" signal)
    (4 "F.Adhes" user "Adhesive on front")
    (5 "B.Adhes" user "Adhesive on back")
    (6 "F.Paste" user)
    (7 "B.Paste" user)
    (8 "F.SilkS" user)
    (9 "B.SilkS" user)
    (10 "F.Mask" user)
    (11 "B.Mask" user)
    (12 "Dwgs.User" user)
    (13 "Cmts.User" user)
    (14 "Eco1.User" user)
    (15 "Eco2.User" user)
    (16 "Edge.Cuts" user)
    (17 "Margin" user)
    (18 "F.CrtYd" user)
    (19 "B.CrtYd" user)
    (20 "F.Fab" user)
    (21 "B.Fab" user)
    (22 "User.1" user)
    (23 "User.2" user)
    (24 "User.3" user)
    (25 "User.4" user)
    (26 "User.5" user)
    (27 "User.6" user)
    (28 "User.7" user)
    (29 "User.8" user)
    (30 "User.9" user)
  )
  (setup
    (pad_to_mask_clearance 0.05)
    (solder_mask_min_width 0.0)
    (pad_to_paste_clearance 0.0)
    (pad_to_paste_clearance_ratio 0.0)
    (allow_soldermask_bridges_in_footprints no)
    (stackup
      (layer "F.Cu" (type "signal") (thickness 0.035))
      (layer "In1.Cu" (type "dielectric") (thickness 0.1) (material "Prepreg") (epsilon_r 4.05))
      (layer "In2.Cu" (type "dielectric") (thickness 1.33) (material "FR4") (epsilon_r 4.5))
      (layer "B.Cu" (type "signal") (thickness 0.035))
      (copper_finish "None")
      (dielectric_constraints yes)
    )
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros false)
      (usegerberextensions false)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
      (dashed_line_dash_ratio 12.0)
      (dashed_line_gap_ratio 3.0)
      (svgprecision 4)
      (plotframeref false)
      (viasonmask false)
      (mode 1)
      (useauxorigin false)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.0)
      (pdf_front_fp_property_popups true)
      (pdf_back_fp_property_popups true)
      (dxfpolygonmode true)
      (dxfimperialunits true)
      (dxfusepcbnewfont true)
      (psnegative false)
      (psa4output false)
      (plotinvisibletext false)
      (sketchpadsonfab false)
      (subtractmaskfromsilk false)
      (outputformat 1)
      (mirror false)
      (drillshape 0)
      (scaleselection 1)
      (outputdirectory "gerber")
    )
  )

