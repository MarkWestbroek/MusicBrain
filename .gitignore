# Build artefacts
build/
out/
dist/
*.o
*.obj
*.elf
*.hex
*.bin
*.map

# Editor / Node
node_modules/
.vite/
.cache/
.pnpm-store/
coverage/
*.tsbuildinfo

# Generated API docs (TypeDoc output)
doc/api/

# TypeScript emit artifacts inside source trees (Vite handles transpilation; tsc should be noEmit)
editor/src/**/*.js
editor/src/**/*.js.map
editor/src/**/*.d.ts

# IDE
.vscode/
.idea/
*.user

# OS
.DS_Store
Thumbs.db
COM5

# KiCad lock-bestanden (per open sessie, geen broncode)
*.lck
~*.kicad_*.lck

# VS Code Local History-extensie (geneste mappen, per bord/project)
.history/

# PlatformIO-administratie: wijzigt bij elke dependency-check (libdeps zelf
# blijft bewust getrackt - ArduinoJson is gevendord en staat niet in lib_deps)
firmware/*/.pio/libdeps/*/integrity.dat

# KiCad-werkbestanden uit de generator/validatie-lus (WERKWIJZE):
# rapporten, netlist-tussenstap, SES-backups, render-checks, DSN-prep
drc.rpt
erc.rpt
*.ses.bak
*-fr.dsn
render-top.png
render-bottom.png
render-persp.png
board-top.svg
hardware/schematics/*/*.net
hardware/kicad-generators/__pycache__/

# Secrets: env-bestanden met o.a. de Imprint INGEST_TOKEN — NOOIT committen.
# Het sjabloon .env.example (zonder waardes) blijft wel getrackt.
.env
.env.*
!.env.example

# Fab-uitvoer: gerber/drill-exports EN de gebundelde zip zijn regenereerbaar uit
# de KiCad-bron (make_fab) - niet tracken. BOM/CPL-CSV's blijven wel getrackt
# (klein, diff-baar, ordergeschiedenis); regenereer de zip vóór het uploaden.
**/fab/gerbers/
**/fab/*-gerbers.zip
