# Sjabloon voor het gitignored .env in deze map. Kopieer naar `.env` en vul in:
#     cp .env.example .env
# Het echte .env (met je token) wordt door .gitignore buiten git gehouden.
# publish_product.mjs leest .env automatisch; een expliciete `export` of --flag
# wint boven de waardes hier.

# Bearer-token voor de Imprint write-API (uit de Plesk-deployomgeving / je admin).
INGEST_TOKEN=

# Doel-site. Uit/leeg = lokaal (http://localhost:3000). Zet op de live-URL om
# standaard naar productie te posten, of geef per run --base mee.
# IMPRINT_BASE=https://musicbrain.nl
