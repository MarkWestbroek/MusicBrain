  (text "VCA8: 1x DAC128S085 octaal 12-bit (DIN <- MOSI, DOUT -> MISO daisy, SYNC <- CS,\nVA = VREF1 = VREF2 = +3V3 -> out 0..3V3). GEEN hardware-LDAC: sync via software\n(WRM + gelijktijdige update). VC: 0V = unity, 3V3 = -100dB (-33mV/dB).\nPOR = 0V = unity = kort vol volume bij power-up; fw schrijft eerst alles op -100dB.\nMODE open = Class AB; audio inverteert (SSI2164 fig 1).\nCH k: DAC VOUTA-D=1-4 VOUTE-H=5-8; J2/J3: 1=GND, 2-9=CH1-8, 10=GND." (exclude_from_sim no) (at 20 30 0)
    (effects (font (size 1.27 1.27)) (justify left)))
  (sheet_instances (path "/" (page "1")))
)
