	(text "Outputs: VOUTA-D via 100R series to J2 (1x5):\n  1 GND, 2 OUTA, 3 OUTB, 4 OUTC, 5 OUTD\n  (100R = short-circuit / cable protection)"
		(exclude_from_sim no)
		(at 165.1 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0677244e-3b21-465c-b2ef-936611114719")
	)
	(text "Power:\n  AVDD = +12V, AVSS = -12V (Eurorack)\n  DVCC = +3V3 (logic side, Teensy/FPGA)\n  Exposed pad (pin 25) tied to AVSS\n  GND / DAC_GND / SIG_GND: one ground plane"
		(exclude_from_sim no)
		(at 165.1 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1c2afd8f-99fb-4696-aa7e-352093524122")
	)
	(text "J1 pinout (2x5 IDC, ribbon to controller):\n  1 GND    2 SYNC\n  3 SDO    4 SDIN\n  5 SCLK   6 GND\n  7 +3V3   8 GND\n  9 -12V   10 +12V"
		(exclude_from_sim no)
		(at 165.1 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "297d0a82-5d59-4c58-87dc-adf526628434")
	)
	(text "Supply decoupling (place at U1 pins on PCB)"
		(exclude_from_sim no)
		(at 53.34 60.96 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "572f6863-a2ae-4e98-8bbb-f33fad97b1dc")
	)
	(text "Reference (MANDATORY):\n  AD5754BREZ (non-R) has NO internal reference.\n  ADR421 = 2.5V ultra-precision (3 ppm/C) -> REFIN.\n  +/-5V range (software config) needs headroom:\n  AVDD/AVSS >= +/-6.5V -> +/-12V is fine."
		(exclude_from_sim no)
		(at 165.1 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "60977d6a-ff0e-495f-8a03-a6ee296e3091")
	)
	(text "SPI (mode 1: CPOL=0, CPHA=1; max 30 MHz):\n  Teensy 4.1: SCLK=13(SCK), SDIN=11(MOSI),\n  SDO=12(MISO), SYNC=10(CS)\n  Data latched into DAC on SYNC rising edge"
		(exclude_from_sim no)
		(at 165.1 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "99c38fb0-1ace-4e28-a693-6ef83be52c1f")
	)
	(text "AD5754 Quad DAC Breakout - MusicBrain"
		(exclude_from_sim no)
		(at 40.64 35.56 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left)
		)
		(uuid "c47acc3d-6865-4be6-aadc-dd0b989d9497")
	)
	(text "Control pins:\n  BIN/2sCOMP -> DVCC: OFFSET BINARY\n    0x0000 = -FS, 0x8000 = 0V, 0xFFFF = +FS\n    (matches SPI-frame spec: 16-bit offset-binary)\n  LDAC -> GND: output updates on SYNC rising edge\n  CLR -> 10k pull-up to DVCC (no accidental clear)"
		(exclude_from_sim no)
		(at 165.1 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dfb8fd98-a207-424d-a86f-36f016260b51")
	)
