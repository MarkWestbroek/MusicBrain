    (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5) (island_removal_mode 1) (island_area_min 10))
    (polygon (pts
      (xy 100.5 100.5) (xy 169.5 100.5)
      (xy 169.5 179.5) (xy 100.5 179.5)
    ))
  )
)
